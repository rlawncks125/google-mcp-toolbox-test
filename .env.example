# Change all passwords before sharing or deploying this stack.
POSTGRES_PASSWORD=local-admin-change-me
TOOLBOX_DB_USER=toolbox_reader
TOOLBOX_DB_PASSWORD=local-reader-change-me
REDIS_PASSWORD=local-redis-change-me
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=local-mongo-root-change-me
MONGO_TOOLBOX_USER=toolbox_monitor
MONGO_TOOLBOX_PASSWORD=local-mongo-monitor-change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-change-me

# Point these at an existing PostgreSQL server if you adapt the compose file.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_SSLMODE=disable
REDIS_HOST=redis
REDIS_PORT=6379
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=app

# Image versions are centralized so upgrades are explicit.
TOOLBOX_VERSION=1.11.0
POSTGRES_VERSION=17-alpine
POSTGRES_EXPORTER_VERSION=v0.18.1
REDIS_VERSION=7.4-alpine
REDIS_EXPORTER_VERSION=v1.77.0
MONGO_VERSION=8.0
MONGODB_EXPORTER_VERSION=0.47.2
OTEL_COLLECTOR_VERSION=0.135.0
PROMETHEUS_VERSION=v3.5.0
LOKI_VERSION=3.5.5
ALLOY_VERSION=v1.11.3
JAEGER_VERSION=2.11.0
GRAFANA_VERSION=12.2.0
