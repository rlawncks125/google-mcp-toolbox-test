discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "observed_containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_observability_logs"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    replacement   = "$1"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.observed_containers.output
  forward_to    = [loki.process.container_logs.receiver]
  refresh_interval = "5s"
}

loki.process "container_logs" {
  stage.json {
    expressions = {
      level           = "severity",
      timestamp       = "timestamp",
      trace_id        = "\"logging.googleapis.com/trace\"",
      span_id         = "\"logging.googleapis.com/spanId\"",
      request_latency = "httpRequest.latency",
      http_status     = "httpRequest.status",
      request_path    = "httpRequest.requestPath",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  // Request and trace identifiers are deliberately structured metadata, not
  // Loki index labels: their high cardinality would create one stream/request.
  stage.structured_metadata {
    values = {
      trace_id        = "",
      span_id         = "",
      request_latency = "",
      http_status     = "",
      request_path    = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
