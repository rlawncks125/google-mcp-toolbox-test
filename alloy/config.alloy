discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "observed_containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_observability_logs"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  // Applications can keep the Loki service label identical to OTel
  // service.name even when the Compose service key is different.
  rule {
    source_labels = ["__meta_docker_container_label_observability_service_name"]
    regex         = "(.+)"
    replacement   = "$1"
    target_label  = "service"
  }

  // Stable database identity labels keep logs from multiple instances separate.
  rule {
    source_labels = ["__meta_docker_container_label_observability_db_system"]
    target_label  = "db_system"
  }

  rule {
    source_labels = ["__meta_docker_container_label_observability_db_cluster"]
    target_label  = "db_cluster"
  }

  rule {
    source_labels = ["__meta_docker_container_label_observability_db_instance"]
    target_label  = "db_instance"
  }

  rule {
    source_labels = ["__meta_docker_container_label_observability_db_role"]
    target_label  = "db_role"
  }

  rule {
    source_labels = ["__meta_docker_container_label_observability_environment"]
    target_label  = "environment"
  }

  // Trace의 juchan-kind와 같은 분류를 Loki label 규칙에 맞춰 저장합니다.
  rule {
    source_labels = ["__meta_docker_container_label_observability_juchan_kind"]
    target_label  = "juchan_kind"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    replacement   = "$1"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.observed_containers.output
  forward_to    = [loki.process.container_logs.receiver]
  refresh_interval = "5s"
}

loki.process "container_logs" {
  // PostgreSQL writes multiline SQL statements as a timestamped first line
  // followed by indented continuation lines. Join them before they reach Loki
  // so one database request is shown as one Grafana log entry.
  stage.match {
    selector = "{service=\"postgres\"}"

    stage.multiline {
      firstline     = "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d+ UTC \\[\\d+\\]"
      max_wait_time = "3s"
    }
  }

  stage.json {
    expressions = {
      level           = "severity",
      timestamp       = "timestamp",
      trace_id        = "\"logging.googleapis.com/trace\"",
      span_id         = "\"logging.googleapis.com/spanId\"",
      request_latency = "httpRequest.latency",
      http_status     = "httpRequest.status",
      request_path    = "httpRequest.requestPath",
    }
  }

  stage.json {
    expressions = {
      trace_id = "trace_id",
      span_id  = "span_id",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  // Request and trace identifiers are deliberately structured metadata, not
  // Loki index labels: their high cardinality would create one stream/request.
  stage.structured_metadata {
    values = {
      trace_id        = "",
      span_id         = "",
      request_latency = "",
      http_status     = "",
      request_path    = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
